{
  "name": "spritemate-msx-vscode-plugin",
  "displayName": "MSX SpriteMate",
  "description": "Design MSX2 V9938 sprites and animations in VS Code. Preview CC color mixing and export C, Z80 assembly, or MSX BASIC DATA.",
  "version": "0.1.0",
  "publisher": "MennoHomanWindigo",
  "author": "Menno Homan (Windigo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Windigo/spritemate-msx-vsc-plugin.git"
  },
  "license": "MIT",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "msx",
    "msx2",
    "v9938",
    "sprite",
    "pixel art",
    "msxgl",
    "retro"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onCommand:spritemateMsx.open",
    "onCustomEditor:spritemateMsx.project"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spritemateMsx.open",
        "title": "MSX SpriteMate: Open Sprite Editor",
        "category": "MSX SpriteMate"
      }
    ],
    "keybindings": [
      {
        "command": "spritemateMsx.open",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "true"
      }
    ],
    "customEditors": [
      {
        "viewType": "spritemateMsx.project",
        "displayName": "MSX SpriteMate Project",
        "selector": [
          {
            "filenamePattern": "*.msxsm"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "./build-extension.sh",
    "prepackage": "node scripts/sync-versions.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2"
  },
  "icon": "icon.png"
}
